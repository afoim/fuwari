---
import ViewsCounter from "@components/ViewsCounter.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="画廊">
	<div class="card-base p-6 md:p-8">
		<div class="flex items-center justify-between gap-3 flex-wrap mb-6">
			<div class="flex items-center gap-2">
				<div class="h-8 w-8 rounded-lg bg-[var(--primary)] flex items-center justify-center text-white dark:text-black/70">
					<Icon name="material-symbols:photo-library-rounded" class="text-[1.5rem]"></Icon>
				</div>
				<h1 class="text-2xl font-bold text-90">画廊</h1>
				<div id="status" class="text-sm font-bold text-50 transition-all"></div>
				<ViewsCounter pathname="/gallery/" />
			</div>
			<div class="flex items-center gap-2">
				<button id="btn-h" type="button" class="btn-regular h-9 px-3 rounded-lg text-sm font-medium">横屏</button>
				<button id="btn-v" type="button" class="btn-regular h-9 px-3 rounded-lg text-sm font-medium">竖屏</button>
				<button id="btn-sort" type="button" class="btn-regular h-9 px-3 rounded-lg text-sm font-medium">随机</button>
			</div>
		</div>

		<div class="text-sm text-50 mb-5 leading-relaxed">
			<!-- 1. 修改这里的API域名展示文本 -->
			图片随机API自托管于： <a href="https://tu.682000.xyz" target="_blank" rel="noopener noreferrer" class="font-medium text-75 hover:text-[var(--primary)] transition-colors">https://tu.682000.xyz</a> 
            <br>
            特别鸣谢：<b class="font-bold text-75">锦瑟/瑞希</b> 大佬提供的图源
		</div>

		<div id="gallery" class="gallery-grid" data-ready="false"></div>
		<div id="footer-status" class="text-center text-sm text-50 h-10 mt-4"></div>
		<div id="sentinel" class="h-4"></div>
	</div>

	<style>
		.gallery-grid {
			width: 100%;
			opacity: 0;
			transform: translateY(4px);
			transition:
				opacity 0.2s ease,
				transform 0.2s ease;
		}
		.gallery-grid[data-ready="true"] {
			opacity: 1;
			transform: translateY(0);
		}
		.gallery-item {
			line-height: 24px;
		}
	</style>

	<script>
		import Masonry from "masonry-layout";
		import imagesLoaded from "imagesloaded";
		import { Fancybox } from "@fancyapps/ui";
		import "@fancyapps/ui/dist/fancybox/fancybox.css";

		// 2. 修改这里的API基础域名（核心修改点）
		const RANDOM_API_BASE = "https://tu.682000.xyz/random";
		// 存储已加载的图片URL，避免重复
		const loadedUrls = new Set();
		// 每页加载数量
		const BATCH_SIZE = 20;
		// 当前选中的图片方向
		let currentOrientation = "landscape"; // landscape=横屏，portrait=竖屏
		let loading = false;
		let msnry = null;
		let io = null;
		let resizeHandler = null;

		// 获取瀑布流列数（响应式）
		function getColumns() {
			const w = window.innerWidth;
			if (w >= 1024) return 4;
			if (w >= 768) return 3;
			return 2;
		}

		// 获取瀑布流布局配置
		function getLayoutConfig(galleryEl) {
			const gutter = 16;
			const cols = getColumns();
			const width = galleryEl.clientWidth || 0;
			const columnWidth = Math.max(
				120,
				Math.floor((width - gutter * (cols - 1)) / cols),
			);
			return { gutter, cols, columnWidth };
		}

		// 更新状态显示
		function setStatus(text) {
			const statusEl = document.getElementById("status");
			if (!statusEl) return;
			statusEl.textContent = text || "";
		}

		// 更新按钮激活状态
		function setActiveButton() {
			const btnH = document.getElementById("btn-h");
			const btnV = document.getElementById("btn-v");
			if (!btnH || !btnV) return;
			const activeClasses = ["ring-2", "ring-[var(--primary)]"];
			for (const c of activeClasses) {
				btnH.classList.toggle(c, currentOrientation === "landscape");
				btnV.classList.toggle(c, currentOrientation === "portrait");
			}
			// 更新状态文本
			setStatus(currentOrientation === "landscape" ? "横屏随机图" : "竖屏随机图");
		}

		// 更新排序按钮（改为随机刷新）
		function updateSortButton() {
			const btnSort = document.getElementById("btn-sort");
			if (!btnSort) return;
			btnSort.textContent = "刷新";
			const activeClasses = ["ring-2", "ring-[var(--primary)]"];
			for (const c of activeClasses) {
				btnSort.classList.remove(c);
			}
		}

		// 调用新API获取随机图URL
		async function fetchRandomImageUrl(orientation) {
			try {
				// 拼接API参数：返回完整URL，格式为JSON，指定方向
				const params = new URLSearchParams({
					type: "url",
					form: "json",
					orientation: orientation,
					content: "image"
				});
				const res = await fetch(`${RANDOM_API_BASE}?${params.toString()}`, {
					cache: "no-cache",
					headers: {
						// 提示客户端发送视口信息（适配auto模式）
						"Accept-CH": "Sec-CH-Viewport-Width, Sec-CH-Viewport-Height",
						"Vary": "Sec-CH-Viewport-Width, Sec-CH-Viewport-Height, User-Agent"
					}
				});
				
				if (!res.ok) throw new Error(`API请求失败: ${res.status}`);
				const data = await res.json();
				
				// 验证URL有效性
				if (!data.url || typeof data.url !== "string") {
					throw new Error("API返回无效URL");
				}
				
				// 处理相对路径
				let imgUrl = data.url;
				if (!imgUrl.startsWith("http")) {
					// 3. 这里会自动基于新的API域名拼接完整URL
					imgUrl = new URL(imgUrl, RANDOM_API_BASE).href;
				}
				
				return imgUrl;
			} catch (e) {
				console.error("获取随机图失败:", e);
				// 降级处理：返回空，后续跳过该图片
				return null;
			}
		}

		// 构建图片卡片
		function buildCard(url, width) {
			const a = document.createElement("a");
			a.href = url;
			a.dataset.fancybox = ""; // 独立展示
			a.className = "gallery-item block opacity-0 transition-opacity duration-300";
			a.style.width = `${width}px`;

			const wrapper = document.createElement("div");
			wrapper.className = "card-base overflow-hidden rounded-xl active:scale-[0.99] transition";

			const img = document.createElement("img");
			img.src = url;
			img.loading = "lazy";
			img.decoding = "async";
			img.alt = "随机画廊图片";
			img.className = "w-full h-auto block";

			wrapper.appendChild(img);
			a.appendChild(wrapper);
			a.appendChild(document.createElement("br"));
			return a;
		}

		// 清空画廊
		function clearGallery() {
			const galleryEl = document.getElementById("gallery");
			if (!galleryEl) return;
			galleryEl.innerHTML = "";
			galleryEl.dataset.ready = "false";
			loadedUrls.clear(); // 清空已加载URL
			if (msnry) {
				msnry.destroy();
				msnry = null;
			}
		}

		// 加载更多图片
		async function loadMore(batch = BATCH_SIZE) {
			const galleryEl = document.getElementById("gallery");
			const footerStatus = document.getElementById("footer-status");
			if (!galleryEl || loading) return;
			
			loading = true;
			if (footerStatus) footerStatus.textContent = "加载中...";

			try {
				const { gutter, columnWidth } = getLayoutConfig(galleryEl);
				// 初始化瀑布流
				if (!msnry) {
					msnry = new Masonry(galleryEl, {
						itemSelector: ".gallery-item",
						gutter,
						columnWidth,
						transitionDuration: "0.2s",
					});
				}

				const frag = document.createDocumentFragment();
				const items = [];
				// 批量获取随机图
				for (let i = 0; i < batch; i++) {
					const imgUrl = await fetchRandomImageUrl(currentOrientation);
					// 跳过无效URL或重复URL
					if (!imgUrl || loadedUrls.has(imgUrl)) continue;
					
					loadedUrls.add(imgUrl);
					const el = buildCard(imgUrl, columnWidth);
					items.push(el);
					frag.appendChild(el);
				}

				if (items.length > 0) {
					galleryEl.appendChild(frag);
					// 等待图片加载完成后更新瀑布流
					await new Promise((resolve) => {
						imagesLoaded(items, () => {
							if (!msnry) return resolve();
							msnry.appended(items);
							msnry.layout();
							// 显示图片
							for (const item of items) {
								item.classList.remove("opacity-0");
							}
							if (galleryEl.dataset.ready !== "true") {
								galleryEl.dataset.ready = "true";
							}
							resolve();
						});
					});
				}

				// 更新底部状态
				if (footerStatus) {
					footerStatus.textContent = items.length > 0 ? "" : "暂无更多图片";
				}

				// 无限滚动：如果还有空间，继续加载
				const sentinelEl = document.getElementById("sentinel");
				if (sentinelEl && items.length > 0) {
					const rect = sentinelEl.getBoundingClientRect();
					if (rect.top < window.innerHeight + 600) {
						setTimeout(() => loadMore(batch), 100);
					}
				}
			} finally {
				loading = false;
			}
		}

		// 切换图片方向（横/竖屏）
		function setOrientation(orientation) {
			if (!["landscape", "portrait"].includes(orientation)) return;
			if (currentOrientation === orientation) return;
			
			currentOrientation = orientation;
			setActiveButton();
			clearGallery();
			loadMore(BATCH_SIZE);
		}

		// 刷新当前方向的图片
		function refreshGallery() {
			clearGallery();
			loadMore(BATCH_SIZE);
		}

		// 设置无限滚动监听
		function setupInfiniteLoad() {
			const sentinelEl = document.getElementById("sentinel");
			if (!sentinelEl) return;
			if (io) io.disconnect();
			
			io = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting && !loading)) {
						loadMore(BATCH_SIZE);
					}
				},
				{ rootMargin: "600px 0px" }
			);
			io.observe(sentinelEl);
		}

		// 设置窗口大小调整监听
		function setupResize() {
			if (resizeHandler) window.removeEventListener("resize", resizeHandler);
			
			resizeHandler = () => {
				const galleryEl = document.getElementById("gallery");
				if (!galleryEl || !msnry) return;
				
				const { gutter, columnWidth } = getLayoutConfig(galleryEl);
				// 更新所有图片卡片宽度
				galleryEl.querySelectorAll(".gallery-item").forEach(el => {
					el.style.width = `${columnWidth}px`;
				});
				// 更新瀑布流配置
				msnry.options.gutter = gutter;
				msnry.options.columnWidth = columnWidth;
				msnry.layout();
			};
			
			window.addEventListener("resize", resizeHandler, { passive: true });
		}

		// 初始化
		async function init() {
			const galleryEl = document.getElementById("gallery");
			if (!galleryEl || galleryEl.dataset.inited === "true") return;
			
			galleryEl.dataset.inited = "true";
			// 初始化按钮状态
			setActiveButton();
			updateSortButton();
			// 加载首批图片
			await loadMore(BATCH_SIZE);
			// 设置无限滚动和窗口调整监听
			setupInfiniteLoad();
			setupResize();

			// 绑定按钮事件
			const btnH = document.getElementById("btn-h");
			const btnV = document.getElementById("btn-v");
			const btnSort = document.getElementById("btn-sort");
			
			if (btnH) btnH.addEventListener("click", () => setOrientation("landscape"));
			if (btnV) btnV.addEventListener("click", () => setOrientation("portrait"));
			if (btnSort) btnSort.addEventListener("click", refreshGallery);

			// 绑定Fancybox图片预览
			Fancybox.bind("[data-fancybox]", {
				groupAll: false,
				Toolbar: {
					display: {
						left: ["infobar"],
						middle: [
							"zoomIn",
							"zoomOut",
							"toggle1to1",
							"rotateCCW",
							"rotateCW",
							"flipX",
							"flipY",
						],
						right: ["slideshow", "fullscreen", "download", "thumbs", "close"],
					},
				},
				Thumbs: {
					type: "classic",
				},
				Carousel: {
					Navigation: false,
				},
			});
		}

		// 初始化入口
		function initIfPresent() {
			const galleryEl = document.getElementById("gallery");
			if (!galleryEl) return;
			init();
		}

		// Astro页面切换清理
		document.addEventListener("astro:before-swap", () => {
			Fancybox.destroy();
			if (io) io.disconnect();
			if (resizeHandler) window.removeEventListener("resize", resizeHandler);
		});

		// 页面加载完成初始化
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initIfPresent);
		} else {
			initIfPresent();
		}

		// 监听页面切换事件
		document.addEventListener("astro:after-swap", initIfPresent);
		document.addEventListener("content:replace", initIfPresent);
		document.addEventListener("swup:contentReplaced", initIfPresent);
	</script>
</MainGridLayout>