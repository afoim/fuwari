---
import ViewsCounter from "@components/ViewsCounter.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="画廊">
	<div class="card-base p-6 md:p-8">
		<div class="flex items-center justify-between gap-3 flex-wrap mb-6">
			<div class="flex items-center gap-2">
				<div class="h-8 w-8 rounded-lg bg-[var(--primary)] flex items-center justify-center text-white dark:text-black/70">
					<Icon name="material-symbols:photo-library-rounded" class="text-[1.5rem]"></Icon>
				</div>
				<h1 class="text-2xl font-bold text-90">画廊</h1>
				<div id="status" class="text-sm font-bold text-50 transition-all"></div>
				<ViewsCounter pathname="/gallery/" />
			</div>
			<div class="flex items-center gap-2">
				<button id="btn-h" type="button" class="btn-regular h-9 px-3 rounded-lg text-sm font-medium">横屏</button>
				<button id="btn-v" type="button" class="btn-regular h-9 px-3 rounded-lg text-sm font-medium">竖屏</button>
				<button id="btn-sort" type="button" class="btn-regular h-9 px-3 rounded-lg text-sm font-medium">随机</button>
			</div>
		</div>

		<div class="text-sm text-50 mb-5 leading-relaxed">
			<!-- 可自选：tu.fqzlr.top / tu.682000.xyz，保持和下方API_BASE一致 -->
			图片随机API自托管于： <a href="https://tu.fqzlr.top" target="_blank" rel="noopener noreferrer" class="font-medium text-75 hover:text-[var(--primary)] transition-colors">https://tu.fqzlr.top</a> 
            <br>
            特别鸣谢：<b class="font-bold text-75">锦瑟/瑞希</b> 大佬提供的图源
		</div>

		<div id="gallery" class="gallery-grid" data-ready="false"></div>
		<div id="footer-status" class="text-center text-sm text-50 h-10 mt-4"></div>
		<div id="sentinel" class="h-4"></div>
	</div>

	<style>
		.gallery-grid {
			width: 100%;
			opacity: 0;
			transform: translateY(4px);
			transition:
				opacity 0.2s ease,
				transform 0.2s ease;
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
			gap: 16px;
		}
		.gallery-grid[data-ready="true"] {
			opacity: 1;
			transform: translateY(0);
		}
		.gallery-item {
			width: 100% !important;
			line-height: 24px;
		}
		.gallery-item .card-base {
			overflow: hidden;
			border-radius: 12px;
		}
		.gallery-item img {
			width: 100%;
			height: auto;
			object-fit: cover;
			transition: transform 0.3s ease;
		}
		.gallery-item:hover img {
			transform: scale(1.03);
		}
	</style>

	<script>
		import Masonry from "masonry-layout";
		import imagesLoaded from "imagesloaded";
		import { Fancybox } from "@fancyapps/ui";
		import "@fancyapps/ui/dist/fancybox/fancybox.css";

		// 核心配置：二选一【https://tu.fqzlr.top / https://tu.682000.xyz】，和上方展示域名一致
		const API_DOMAIN = "https://tu.fqzlr.top";
		const RANDOM_API_BASE = `${API_DOMAIN}/random`;
		// 你的图片目录：已配置权限的mn_background（固定，不要改）
		const IMG_DIR = "mn_background";
		// 存储已加载的图片URL，避免重复
		const loadedUrls = new Set();
		// 每页加载数量（建议10，避免请求过多）
		const BATCH_SIZE = 10;
		// 当前选中的图片方向
		let currentOrientation = "landscape"; // landscape=横屏，portrait=竖屏
		let loading = false;
		let msnry = null;
		let io = null;
		let resizeHandler = null;

		// 更新状态显示
		function setStatus(text) {
			const statusEl = document.getElementById("status");
			if (!statusEl) return;
			statusEl.textContent = text || "";
		}

		// 更新按钮激活状态
		function setActiveButton() {
			const btnH = document.getElementById("btn-h");
			const btnV = document.getElementById("btn-v");
			if (!btnH || !btnV) return;
			const activeClasses = ["ring-2", "ring-[var(--primary)]"];
			btnH.classList.toggle(...activeClasses, currentOrientation === "landscape");
			btnV.classList.toggle(...activeClasses, currentOrientation === "portrait");
			setStatus(currentOrientation === "landscape" ? "横屏随机图" : "竖屏随机图");
		}

		// 刷新按钮文字
		function updateSortButton() {
			const btnSort = document.getElementById("btn-sort");
			if (!btnSort) return;
			btnSort.textContent = "刷新";
		}

		// 调用你的图床API获取随机图URL（完全匹配你的API规则）
		async function fetchRandomImageUrl(orientation) {
			try {
				// 只保留你的图床支持的参数：dir/type/orientation，删除无效的form/content
				const params = new URLSearchParams({
					dir: IMG_DIR, // 固定mn_background，必须传
					type: "url",  // 返回图片URL，适配代码解析
					orientation: orientation, // 横/竖屏
					t: Date.now() // 禁用缓存，每次获取新图
				});
				// 发送请求（关闭跨域校验模式，适配你的图床未配置CORS的情况）
				const res = await fetch(`${RANDOM_API_BASE}?${params.toString()}`, {
					cache: "no-cache",
					mode: "no-cors" // 关键：适配图床未配置CORS，避免前端fetch报错
				});

				// 你的API返回纯URL文本，非JSON，直接解析文本
				const imgUrl = await res.text();
				// 验证URL有效性
				if (!imgUrl || !imgUrl.startsWith("http") || loadedUrls.has(imgUrl)) {
					return null;
				}
				return imgUrl.trim();
			} catch (e) {
				console.error("获取随机图失败:", e);
				return null;
			}
		}

		// 构建图片卡片（适配响应式网格）
		function buildCard(url) {
			const a = document.createElement("a");
			a.href = url;
			a.dataset.fancybox = "gallery"; // 归为一个相册，支持左右切换
			a.className = "gallery-item block opacity-0 transition-opacity duration-300";

			const wrapper = document.createElement("div");
			wrapper.className = "card-base overflow-hidden rounded-xl active:scale-[0.99] transition";

			const img = document.createElement("img");
			img.src = url;
			img.loading = "lazy";
			img.decoding = "async";
			img.alt = "随机画廊图片";
			img.onerror = () => {
				// 图片加载失败的兜底：用你的图床固定图片
				img.src = `${API_DOMAIN}/file/${IMG_DIR}/1771908288760_图片编辑需求.webp`;
			};

			wrapper.appendChild(img);
			a.appendChild(wrapper);
			return a;
		}

		// 清空画廊
		function clearGallery() {
			const galleryEl = document.getElementById("gallery");
			if (!galleryEl) return;
			galleryEl.innerHTML = "";
			galleryEl.dataset.ready = "false";
			loadedUrls.clear();
			if (msnry) {
				msnry.destroy();
				msnry = null;
			}
		}

		// 加载更多图片
		async function loadMore(batch = BATCH_SIZE) {
			const galleryEl = document.getElementById("gallery");
			const footerStatus = document.getElementById("footer-status");
			if (!galleryEl || loading) return;
			
			loading = true;
			footerStatus && (footerStatus.textContent = "加载中...");

			try {
				const frag = document.createDocumentFragment();
				const validImgs = [];
				// 批量获取图片，过滤无效/重复的
				for (let i = 0; i < batch; i++) {
					const imgUrl = await fetchRandomImageUrl(currentOrientation);
					if (!imgUrl) continue;
					loadedUrls.add(imgUrl);
					const card = buildCard(imgUrl);
					validImgs.push(card);
					frag.appendChild(card);
				}

				// 有有效图片才渲染
				if (validImgs.length > 0) {
					galleryEl.appendChild(frag);
					// 图片加载完成后显示并初始化瀑布流
					imagesLoaded(validImgs, () => {
						validImgs.forEach(card => card.classList.remove("opacity-0"));
						galleryEl.dataset.ready = "true";
						// 瀑布流适配
						if (!msnry) {
							msnry = new Masonry(galleryEl, {
								itemSelector: ".gallery-item",
								gutter: 16,
								transitionDuration: "0.2s",
							});
						} else {
							msnry.appended(validImgs);
							msnry.layout();
						}
					});
					footerStatus && (footerStatus.textContent = "");
				} else {
					footerStatus && (footerStatus.textContent = "暂无更多图片");
				}

				// 无限滚动：滚动到底部继续加载
				const sentinelEl = document.getElementById("sentinel");
				if (sentinelEl && validImgs.length > 0) {
					const rect = sentinelEl.getBoundingClientRect();
					if (rect.top < window.innerHeight + 600) {
						setTimeout(() => loadMore(batch), 200);
					}
				}
			} finally {
				loading = false;
			}
		}

		// 切换横/竖屏
		function setOrientation(orientation) {
			if (currentOrientation === orientation) return;
			currentOrientation = orientation;
			setActiveButton();
			clearGallery();
			loadMore(BATCH_SIZE);
		}

		// 刷新画廊
		function refreshGallery() {
			clearGallery();
			loadMore(BATCH_SIZE);
		}

		// 无限滚动监听
		function setupInfiniteLoad() {
			const sentinelEl = document.getElementById("sentinel");
			if (!sentinelEl) return;
			io && io.disconnect();
			io = new IntersectionObserver(
				(entries) => {
					if (entries.some(e => e.isIntersecting && !loading)) {
						loadMore(BATCH_SIZE);
					}
				},
				{ rootMargin: "600px 0px" }
			);
			io.observe(sentinelEl);
		}

		// 窗口大小调整适配
		function setupResize() {
			if (resizeHandler) window.removeEventListener("resize", resizeHandler);
			resizeHandler = () => {
				if (msnry) msnry.layout();
			};
			window.addEventListener("resize", resizeHandler, { passive: true });
		}

		// 初始化
		async function init() {
			const galleryEl = document.getElementById("gallery");
			if (!galleryEl || galleryEl.dataset.inited === "true") return;
			galleryEl.dataset.inited = "true";
			
			setActiveButton();
			updateSortButton();
			await loadMore(BATCH_SIZE);
			setupInfiniteLoad();
			setupResize();

			// 绑定按钮事件
			document.getElementById("btn-h")?.addEventListener("click", () => setOrientation("landscape"));
			document.getElementById("btn-v")?.addEventListener("click", () => setOrientation("portrait"));
			document.getElementById("btn-sort")?.addEventListener("click", refreshGallery);

			// 图片预览配置
			Fancybox.bind("[data-fancybox]", {
				groupAll: false,
				Toolbar: {
					display: {
						left: ["infobar"],
						middle: ["zoomIn", "zoomOut", "toggle1to1", "rotateCCW", "rotateCW"],
						right: ["slideshow", "fullscreen", "download", "thumbs", "close"],
					},
				},
				Thumbs: { type: "classic" },
				Carousel: { Navigation: false },
				
			});
		}

		// 页面加载初始化
		function initIfPresent() {
			document.getElementById("gallery") && init();
		}

		// Astro页面切换清理
		document.addEventListener("astro:before-swap", () => {
			Fancybox.destroy();
			io && io.disconnect();
			resizeHandler && window.removeEventListener("resize", resizeHandler);
		});

		// 初始化入口
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initIfPresent);
		} else {
			initIfPresent();
		}
		document.addEventListener("astro:after-swap", initIfPresent);
		document.addEventListener("content:replace", initIfPresent);
	</script>
</MainGridLayout>