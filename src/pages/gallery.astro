<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>图床API测试</title>
    <style>
        body { padding: 50px; }
        .test-box { border: 1px solid #eee; padding: 20px; border-radius: 8px; }
        img { max-width: 100%; border-radius: 4px; }
        .error { color: red; margin-top: 10px; }
        .success { color: green; margin-top: 10px; }
    </style>
</head>
<body>
    <div class="test-box">
        <h3>图床API测试（mn_background - 横屏）</h3>
        <!-- 核心API：直接返回图片，无需解析URL -->
        <img 
            id="test-img"
            src="https://tu.fqzlr.top/random?type=img&dir=mn_background&orientation=landscape&t=<%= Date.now() %>" 
            alt="测试图片"
            onload="document.getElementById('status').className='success'; document.getElementById('status').textContent='✅ 图片加载成功！'"
            onerror="document.getElementById('status').className='error'; document.getElementById('status').textContent='❌ 图片加载失败，请检查API/目录/权限'"
        >
        <div id="status"></div>
    </div>

    <!-- 额外：竖屏测试（可选） -->
    <div class="test-box" style="margin-top: 20px;">
        <h3>图床API测试（mn_background - 竖屏）</h3>
        <img 
            src="https://tu.fqzlr.top/random?type=img&dir=mn_background&orientation=portrait&t=<%= Date.now() %>" 
            alt="竖屏测试图片"
            onload="this.nextElementSibling.className='success'; this.nextElementSibling.textContent='✅ 竖屏图片加载成功！'"
            onerror="this.nextElementSibling.className='error'; this.nextElementSibling.textContent='❌ 竖屏图片加载失败'"
        >
        <div></div>
    </div>
</body>
</html>